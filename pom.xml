<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.guzula.pswitch</groupId>
  <artifactId>switch</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>switch</name>
  <description>Payment switch (switch de adquirente) em Java. Referência de arquitetura: guzula-switch (NestJS/TypeScript).</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.4</spring-boot.version>
    <netty.version>4.1.113.Final</netty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-all</artifactId>
        <version>${netty.version}</version>
      </dependency>

      <!-- módulos internos -->
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-transport</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-registry</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-external</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-comum</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-nucleo</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-brand-visa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-capture-pos</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.guzula.pswitch</groupId>
        <artifactId>pswitch-liquidacao</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>pswitch-shared</module>
    <module>pswitch-transport</module>
    <module>pswitch-registry</module>
    <module>pswitch-external</module>
    <module>pswitch-comum</module>
    <module>pswitch-nucleo</module>
    <module>pswitch-brand-visa</module>
    <module>pswitch-capture-pos</module>
    <module>pswitch-liquidacao</module>
    <module>pswitch-app</module>
  </modules>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
